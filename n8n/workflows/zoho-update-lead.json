        "mode": "runOnceForEachItem",
        "jsCode": "const input = $json.body ?? {};\nconst errors = [];\nconst leadId = typeof input.id === \"string\" ? input.id.trim() : String(input.id ?? \"\").trim();\nconst allowedFields = new Set([\"First_Name\", \"Last_Name\", \"Company\", \"Email\", \"Description\", \"Lista_de_op_es\"]);\nconst payload = {};\n\nif (!/^\\d{10,30}$/.test(leadId)) {\n  errors.push(\"id deve conter somente números.\");\n}\n\nfor (const [field, value] of Object.entries(input)) {\n  if (field === \"id\") continue;\n  if (!allowedFields.has(field)) {\n    errors.push(`Campo não permitido: ${field}.`);\n    continue;\n  }\n  if (typeof value !== \"string\" || !value.trim()) {\n    errors.push(`${field} deve ser informado como texto não vazio.`);\n    continue;\n  }\n  payload[field] = value.trim();\n}\n\nif (Object.keys(payload).length === 0) {\n  errors.push(\"Informe pelo menos um campo para atualizar.\");\n}\n\nif (payload.Email && !/^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(payload.Email)) {\n  errors.push(\"Email possui formato inválido.\");\n}\n\nreturn { valid: errors.length === 0, errors, leadId, payload };"
      },
