        "mode": "runOnceForEachItem",
        "jsCode": "const input = $json.body ?? {};\n\nconst normalizeText = (value) => {\n  if (typeof value !== \"string\") {\n    return value;\n  }\n\n  const normalized = value.trim();\n  return normalized || undefined;\n};\n\nconst payload = {\n  First_Name: normalizeText(input.First_Name),\n  Last_Name: normalizeText(input.Last_Name),\n  Company: normalizeText(input.Company),\n  Email: normalizeText(input.Email),\n  Description: normalizeText(input.Description),\n};\n\nconst errors = [];\n\nif (!payload.Last_Name) {\n  errors.push(\"Last_Name é obrigatório.\");\n}\n\nif (!payload.Company) {\n  errors.push(\"Company é obrigatório.\");\n}\n\nif (\n  payload.Email &&\n  !/^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(payload.Email)\n) {\n  errors.push(\"Email possui formato inválido.\");\n}\n\nfor (const field of Object.keys(payload)) {\n  if (payload[field] === undefined) {\n    delete payload[field];\n  }\n}\n\nreturn {\n  valid: errors.length === 0,\n  errors,\n  payload,\n};"
      },
